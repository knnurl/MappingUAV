# filepath: deploy/systemd/drone-stack.env
# Installed as /etc/default/drone-stack. Read by the run_*.sh wrappers.
# Raise a layer only after its gate token (masterplan §1.1).
DRONE_SERIAL_DEV=/dev/serial/by-id/usb-FTDI_TTL232RG-VSW3V3_FTADW2E6-if00-port0
DRONE_LIO=upstream          # upstream | fork (fork only after docs/lio_swap_runbook.txt)
DRONE_MAPPING=false         # map, map saver, health guard, planner        [gate5]
DRONE_EXPLORER=false        # frontier explorer                            [gate6]
DRONE_SAVE_MAP=true
