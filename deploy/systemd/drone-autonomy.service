# filepath: deploy/systemd/drone-autonomy.service
# Geofence watchdog, and per /etc/default/drone-stack the map, planner and
# explorer. Aerostack2 is drone-as2.service. THE ENABLE/DISABLE TOGGLE OF
# drone-as2 AND THIS UNIT IS THE ON-VEHICLE SOFTWARE KILL FOR AUTONOMY (WP-G).
# Ships disabled; integration requires the gate5 token.
[Unit]
Description=Drone: geofence watchdog, map, planner, explorer
After=drone-perception.service
Requires=drone-perception.service

[Service]
User=neric
Environment=HOME=/home/neric
ExecStart=/home/neric/colcon_ws/scripts/run_autonomy.sh
Restart=on-failure
RestartSec=3
LogRateLimitIntervalSec=30
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
