+/**
+ * @file offboard_node_gtest.cpp
+ *
+ * Node-level tests of the offboard policy (offboard_guard.hpp): a real
+ * PixhawkPlatform node against a fake PX4 that publishes the /fmu/out topics
+ * the platform reads, asserting exactly what the platform sends on /fmu/in.
+ *
+ * SAFETY: every test skips unless ROS_DOMAIN_ID is set and is not 0 (PX4's
+ * default domain), so these tests cannot reach a flight controller. Run them
+ * with the XRCE agent stopped, ROS_LOCALHOST_ONLY=1 and CYCLONEDDS_URI unset.
+ */
+
+#include <gtest/gtest.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <ament_index_cpp/get_package_share_directory.hpp>
+#include <as2_msgs/msg/control_mode.hpp>
+#include <as2_msgs/srv/set_control_mode.hpp>
+#include <geometry_msgs/msg/twist_stamped.hpp>
+#include <px4_msgs/msg/estimator_status_flags.hpp>
+#include <px4_msgs/msg/offboard_control_mode.hpp>
+#include <px4_msgs/msg/trajectory_setpoint.hpp>
+#include <px4_msgs/msg/vehicle_attitude_setpoint.hpp>
+#include <px4_msgs/msg/vehicle_command.hpp>
+#include <px4_msgs/msg/vehicle_control_mode.hpp>
+#include <px4_msgs/msg/vehicle_odometry.hpp>
+#include <px4_msgs/msg/vehicle_rates_setpoint.hpp>
+#include <rclcpp/rclcpp.hpp>
+#include <std_srvs/srv/set_bool.hpp>
+
+#include "pixhawk_platform.hpp"
+
+namespace as2_platform_pixhawk
+{
+namespace
+{
+
+using namespace std::chrono_literals;  // NOLINT
+
+const char kNamespace[] = "offboard_node_test";
+
+std::string inNamespace(const std::string & name)
+{
+  return std::string("/") + kNamespace + "/" + name;
+}
+
+struct Recorded
+{
+  std::vector<px4_msgs::msg::OffboardControlMode> heartbeats;
+  std::vector<px4_msgs::msg::TrajectorySetpoint> setpoints;
+  std::vector<px4_msgs::msg::VehicleCommand> commands;
+};
+
+// Fake PX4: publishes vehicle_control_mode, estimator_status_flags and
+// vehicle_odometry every 20 ms, plus an AS2 actuator twist, and records what
+// the platform sends on /fmu/in.
+class FakePx4 : public rclcpp::Node
+{
+public:
+  FakePx4()
+  : Node("fake_px4")
+  {
+    const auto qos = rclcpp::SensorDataQoS();
+    control_mode_pub_ = create_publisher<px4_msgs::msg::VehicleControlMode>(
+      "/fmu/out/vehicle_control_mode", qos);
+    odometry_pub_ = create_publisher<px4_msgs::msg::VehicleOdometry>(
+      "/fmu/out/vehicle_odometry", qos);
+    flags_pub_ = create_publisher<px4_msgs::msg::EstimatorStatusFlags>(
+      "/fmu/out/estimator_status_flags", qos);
+    twist_pub_ = create_publisher<geometry_msgs::msg::TwistStamped>(
+      inNamespace("actuator_command/twist"), rclcpp::QoS(10));
+
+    heartbeat_sub_ = create_subscription<px4_msgs::msg::OffboardControlMode>(
+      "/fmu/in/offboard_control_mode", qos,
+      [this](px4_msgs::msg::OffboardControlMode::SharedPtr msg) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        recorded_.heartbeats.push_back(*msg);
+      });
+    setpoint_sub_ = create_subscription<px4_msgs::msg::TrajectorySetpoint>(
+      "/fmu/in/trajectory_setpoint", qos,
+      [this](px4_msgs::msg::TrajectorySetpoint::SharedPtr msg) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        recorded_.setpoints.push_back(*msg);
+      });
+    command_sub_ = create_subscription<px4_msgs::msg::VehicleCommand>(
+      "/fmu/in/vehicle_command", qos,
+      [this](px4_msgs::msg::VehicleCommand::SharedPtr msg) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        recorded_.commands.push_back(*msg);
+      });
+    rates_sub_ = create_subscription<px4_msgs::msg::VehicleRatesSetpoint>(
+      "/fmu/in/vehicle_rates_setpoint", qos,
+      [this](px4_msgs::msg::VehicleRatesSetpoint::SharedPtr) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++rates_and_attitude_setpoints_;
+      });
+    attitude_sub_ = create_subscription<px4_msgs::msg::VehicleAttitudeSetpoint>(
+      "/fmu/in/vehicle_attitude_setpoint", qos,
+      [this](px4_msgs::msg::VehicleAttitudeSetpoint::SharedPtr) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        ++rates_and_attitude_setpoints_;
+      });
+
+    offboard_client_ = create_client<std_srvs::srv::SetBool>(inNamespace("set_offboard_mode"));
+    mode_client_ = create_client<as2_msgs::srv::SetControlMode>(
+      inNamespace("set_platform_control_mode"));
+
+    timer_ = create_wall_timer(20ms, [this]() {publishState();});
+  }
+
+  void set(bool offboard, bool armed, bool in_air)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    offboard_ = offboard;
+    armed_ = armed;
+    in_air_ = in_air;
+  }
+
+  void setPose(float x, float y, float z, float yaw)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    x_ = x;
+    y_ = y;
+    z_ = z;
+    yaw_ = yaw;
+  }
+
+  void setOdometryEnabled(bool enabled)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    odometry_enabled_ = enabled;
+  }
+
+  void setTwistUp(double vz)
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    twist_up_ = vz;
+  }
+
+  void clear()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    recorded_ = Recorded();
+  }
+
+  Recorded snapshot()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return recorded_;
+  }
+
+  int ratesAndAttitudeSetpoints()
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return rates_and_attitude_setpoints_;
+  }
+
+  // Empty optional: no response.
+  std::optional<bool> requestOffboard()
+  {
+    auto request = std::make_shared<std_srvs::srv::SetBool::Request>();
+    request->data = true;
+    if (!offboard_client_->wait_for_service(3s)) {
+      return std::nullopt;
+    }
+    auto future = offboard_client_->async_send_request(request);
+    if (future.wait_for(3s) != std::future_status::ready) {
+      return std::nullopt;
+    }
+    return future.get()->success;
+  }
+
+  std::optional<bool> requestSpeedMode()
+  {
+    auto request = std::make_shared<as2_msgs::srv::SetControlMode::Request>();
+    request->control_mode.control_mode = as2_msgs::msg::ControlMode::SPEED;
+    request->control_mode.yaw_mode = as2_msgs::msg::ControlMode::YAW_SPEED;
+    request->control_mode.reference_frame = as2_msgs::msg::ControlMode::LOCAL_ENU_FRAME;
+    if (!mode_client_->wait_for_service(3s)) {
+      return std::nullopt;
+    }
+    auto future = mode_client_->async_send_request(request);
+    if (future.wait_for(3s) != std::future_status::ready) {
+      return std::nullopt;
+    }
+    return future.get()->success;
+  }
+
+private:
+  void publishState()
+  {
+    px4_msgs::msg::VehicleControlMode mode;
+    px4_msgs::msg::EstimatorStatusFlags flags;
+    px4_msgs::msg::VehicleOdometry odometry;
+    geometry_msgs::msg::TwistStamped twist;
+    bool odometry_enabled = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      mode.flag_armed = armed_;
+      mode.flag_control_offboard_enabled = offboard_;
+      flags.cs_in_air = in_air_;
+      odometry.pose_frame = px4_msgs::msg::VehicleOdometry::POSE_FRAME_NED;
+      odometry.velocity_frame = px4_msgs::msg::VehicleOdometry::VELOCITY_FRAME_NED;
+      odometry.position = {x_, y_, z_};
+      odometry.q = {std::cos(yaw_ / 2.0f), 0.0f, 0.0f, std::sin(yaw_ / 2.0f)};
+      odometry.velocity = {0.0f, 0.0f, 0.0f};
+      odometry.angular_velocity = {0.0f, 0.0f, 0.0f};
+      odometry_enabled = odometry_enabled_;
+      twist.twist.linear.z = twist_up_;
+    }
+    control_mode_pub_->publish(mode);
+    flags_pub_->publish(flags);
+    if (odometry_enabled) {
+      odometry_pub_->publish(odometry);
+    }
+    twist.header.stamp = now();
+    twist_pub_->publish(twist);
+  }
+
+  std::mutex mutex_;
+  bool offboard_ = false;
+  bool armed_ = false;
+  bool in_air_ = false;
+  bool odometry_enabled_ = true;
+  float x_ = 1.0f;
+  float y_ = 2.0f;
+  float z_ = -3.0f;
+  float yaw_ = 0.5f;
+  double twist_up_ = 0.0;
+  Recorded recorded_;
+  int rates_and_attitude_setpoints_ = 0;
+
+  rclcpp::Publisher<px4_msgs::msg::VehicleControlMode>::SharedPtr control_mode_pub_;
+  rclcpp::Publisher<px4_msgs::msg::VehicleOdometry>::SharedPtr odometry_pub_;
+  rclcpp::Publisher<px4_msgs::msg::EstimatorStatusFlags>::SharedPtr flags_pub_;
+  rclcpp::Publisher<geometry_msgs::msg::TwistStamped>::SharedPtr twist_pub_;
+  rclcpp::Subscription<px4_msgs::msg::OffboardControlMode>::SharedPtr heartbeat_sub_;
+  rclcpp::Subscription<px4_msgs::msg::TrajectorySetpoint>::SharedPtr setpoint_sub_;
+  rclcpp::Subscription<px4_msgs::msg::VehicleCommand>::SharedPtr command_sub_;
+  rclcpp::Subscription<px4_msgs::msg::VehicleRatesSetpoint>::SharedPtr rates_sub_;
+  rclcpp::Subscription<px4_msgs::msg::VehicleAttitudeSetpoint>::SharedPtr attitude_sub_;
+  rclcpp::Client<std_srvs::srv::SetBool>::SharedPtr offboard_client_;
+  rclcpp::Client<as2_msgs::srv::SetControlMode>::SharedPtr mode_client_;
+  rclcpp::TimerBase::SharedPtr timer_;
+};
+
+std::shared_ptr<PixhawkPlatform> makePlatform()
+{
+  const std::string share = ament_index_cpp::get_package_share_directory("as2_platform_pixhawk");
+  rclcpp::NodeOptions options;
+  options.arguments(
+      {
+        "--ros-args",
+        "-r", std::string("__ns:=/") + kNamespace,
+        "-p", std::string("namespace:=") + kNamespace,
+        "-p", "use_sim_time:=false",
+        "-p", "control_modes_file:=" + share + "/config/control_modes.yaml",
+        "--params-file", share + "/config/platform_config_file.yaml",
+      });
+  return std::make_shared<PixhawkPlatform>(options);
+}
+
+class OffboardNodeTest : public ::testing::Test
+{
+protected:
+  static void SetUpTestSuite()
+  {
+    if (!rclcpp::ok()) {
+      rclcpp::init(0, nullptr);
+    }
+  }
+
+  static void TearDownTestSuite()
+  {
+    rclcpp::shutdown();
+  }
+
+  void SetUp() override
+  {
+    const char * domain = std::getenv("ROS_DOMAIN_ID");
+    if (domain == nullptr || std::string(domain).empty() || std::string(domain) == "0") {
+      GTEST_SKIP() << "Set ROS_DOMAIN_ID to a non-zero value: domain 0 is the flight controller's";
+    }
+    fake_ = std::make_shared<FakePx4>();
+    platform_ = makePlatform();
+    executor_ = std::make_shared<rclcpp::executors::MultiThreadedExecutor>();
+    executor_->add_node(fake_);
+    executor_->add_node(platform_);
+    spin_thread_ = std::thread([this]() {executor_->spin();});
+    std::this_thread::sleep_for(1500ms);  // discovery
+  }
+
+  void TearDown() override
+  {
+    if (executor_) {
+      executor_->cancel();
+    }
+    if (spin_thread_.joinable()) {
+      spin_thread_.join();
+    }
+    platform_.reset();
+    fake_.reset();
+    executor_.reset();
+  }
+
+  // Waits settle, clears the recording, records for window, returns it.
+  Recorded record(
+    std::chrono::milliseconds settle = 300ms, std::chrono::milliseconds window = 500ms)
+  {
+    std::this_thread::sleep_for(settle);
+    fake_->clear();
+    std::this_thread::sleep_for(window);
+    return fake_->snapshot();
+  }
+
+  std::shared_ptr<FakePx4> fake_;
+  std::shared_ptr<PixhawkPlatform> platform_;
+  std::shared_ptr<rclcpp::executors::MultiThreadedExecutor> executor_;
+  std::thread spin_thread_;
+};
+
+TEST_F(OffboardNodeTest, OutsideOffboardSendsOnlyTheHeartbeatEvenArmedInTheAir)
+{
+  fake_->set(false, true, true);
+  const Recorded r = record();
+  EXPECT_GE(r.heartbeats.size(), 20u);
+  for (const auto & heartbeat : r.heartbeats) {
+    EXPECT_TRUE(heartbeat.position);
+    EXPECT_FALSE(heartbeat.velocity);
+    EXPECT_FALSE(heartbeat.acceleration);
+    EXPECT_FALSE(heartbeat.attitude);
+    EXPECT_FALSE(heartbeat.body_rate);
+  }
+  EXPECT_EQ(r.setpoints.size(), 0u);
+  EXPECT_EQ(r.commands.size(), 0u);
+  EXPECT_EQ(fake_->ratesAndAttitudeSetpoints(), 0);
+}
+
+TEST_F(OffboardNodeTest, StaleOdometryStopsTheHeartbeatAndRefusesOffboard)
+{
+  fake_->set(false, true, true);
+  fake_->setOdometryEnabled(false);
+  Recorded r = record();
+  EXPECT_EQ(r.heartbeats.size(), 0u);
+
+  EXPECT_EQ(fake_->requestOffboard(), std::optional<bool>(false));
+  std::this_thread::sleep_for(200ms);
+  r = fake_->snapshot();
+  EXPECT_EQ(r.commands.size(), 0u);
+  EXPECT_EQ(r.setpoints.size(), 0u);
+
+  fake_->setOdometryEnabled(true);
+  r = record(300ms, 300ms);
+  EXPECT_GE(r.heartbeats.size(), 10u);
+}
+
+TEST_F(OffboardNodeTest, EntryInTheAirHoldsTheEntryPoseAndYaw)
+{
+  fake_->setPose(1.0f, 2.0f, -3.0f, 0.5f);
+  fake_->set(false, true, true);
+  std::this_thread::sleep_for(500ms);
+  fake_->set(true, true, true);  // pilot flips the RC offboard switch
+  std::this_thread::sleep_for(300ms);
+  fake_->setPose(1.5f, 2.5f, -2.5f, 0.9f);  // the vehicle drifts after entry
+  const Recorded r = record(100ms, 500ms);
+
+  ASSERT_GE(r.setpoints.size(), 20u);
+  for (const auto & setpoint : r.setpoints) {
+    EXPECT_FLOAT_EQ(setpoint.position[0], 1.0f);
+    EXPECT_FLOAT_EQ(setpoint.position[1], 2.0f);
+    EXPECT_FLOAT_EQ(setpoint.position[2], -3.0f);
+    EXPECT_NEAR(setpoint.yaw, 0.5f, 1e-5);
+    EXPECT_TRUE(std::isnan(setpoint.velocity[0]));
+    EXPECT_TRUE(std::isnan(setpoint.velocity[1]));
+    EXPECT_TRUE(std::isnan(setpoint.velocity[2]));
+    EXPECT_TRUE(std::isnan(setpoint.acceleration[2]));
+  }
+  for (const auto & heartbeat : r.heartbeats) {
+    EXPECT_TRUE(heartbeat.position);
+  }
+  EXPECT_EQ(fake_->ratesAndAttitudeSetpoints(), 0);
+}
+
+TEST_F(OffboardNodeTest, EntryOnTheGroundSendsZeroVelocityAndNoPosition)
+{
+  fake_->set(false, true, false);
+  std::this_thread::sleep_for(300ms);
+  fake_->set(true, true, false);
+  const Recorded r = record();
+
+  ASSERT_GE(r.setpoints.size(), 20u);
+  for (const auto & setpoint : r.setpoints) {
+    EXPECT_TRUE(std::isnan(setpoint.position[0]));
+    EXPECT_TRUE(std::isnan(setpoint.position[1]));
+    EXPECT_TRUE(std::isnan(setpoint.position[2]));
+    EXPECT_FLOAT_EQ(setpoint.velocity[0], 0.0f);
+    EXPECT_FLOAT_EQ(setpoint.velocity[1], 0.0f);
+    EXPECT_FLOAT_EQ(setpoint.velocity[2], 0.0f);
+  }
+  EXPECT_EQ(fake_->ratesAndAttitudeSetpoints(), 0);
+}
+
+TEST_F(OffboardNodeTest, ForwardsAfterRequestAndModeThenExitEndsSetpointsForThisProcess)
+{
+  fake_->set(false, false, false);
+  std::this_thread::sleep_for(300ms);
+
+  EXPECT_EQ(fake_->requestOffboard(), std::optional<bool>(true));
+  std::this_thread::sleep_for(200ms);
+  {
+    const Recorded r = fake_->snapshot();
+    ASSERT_EQ(r.commands.size(), 1u);
+    EXPECT_EQ(r.commands[0].command, px4_msgs::msg::VehicleCommand::VEHICLE_CMD_DO_SET_MODE);
+    EXPECT_FLOAT_EQ(r.commands[0].param1, 1.0f);
+    EXPECT_FLOAT_EQ(r.commands[0].param2, 6.0f);
+  }
+
+  fake_->set(true, true, false);  // PX4 enters Offboard, vehicle armed on the ground
+  fake_->setTwistUp(0.5);
+  std::this_thread::sleep_for(200ms);
+  EXPECT_EQ(fake_->requestSpeedMode(), std::optional<bool>(true));
+  {
+    const Recorded r = record();
+    ASSERT_GE(r.setpoints.size(), 20u);
+    for (const auto & setpoint : r.setpoints) {
+      EXPECT_NEAR(setpoint.velocity[2], -0.5f, 1e-5);  // ENU up = NED -z
+      EXPECT_TRUE(std::isnan(setpoint.position[2]));
+    }
+    for (const auto & heartbeat : r.heartbeats) {
+      EXPECT_TRUE(heartbeat.velocity);
+      EXPECT_FALSE(heartbeat.position);
+    }
+  }
+
+  fake_->set(false, true, true);  // pilot takes over in the air
+  {
+    const Recorded r = record(200ms, 500ms);
+    EXPECT_EQ(r.setpoints.size(), 0u);
+    ASSERT_GE(r.heartbeats.size(), 20u);
+    for (const auto & heartbeat : r.heartbeats) {
+      EXPECT_TRUE(heartbeat.position);
+    }
+  }
+
+  fake_->setPose(4.0f, 5.0f, -6.0f, 0.1f);
+  fake_->set(true, true, true);  // back into Offboard, same process
+  std::this_thread::sleep_for(200ms);
+  EXPECT_EQ(fake_->requestSpeedMode(), std::optional<bool>(true));
+  {
+    const Recorded r = record();
+    ASSERT_GE(r.setpoints.size(), 20u);
+    for (const auto & setpoint : r.setpoints) {
+      EXPECT_FLOAT_EQ(setpoint.position[0], 4.0f);
+      EXPECT_FLOAT_EQ(setpoint.position[1], 5.0f);
+      EXPECT_FLOAT_EQ(setpoint.position[2], -6.0f);
+      EXPECT_NEAR(setpoint.yaw, 0.1f, 1e-5);
+      EXPECT_TRUE(std::isnan(setpoint.velocity[2]));
+    }
+  }
+  EXPECT_EQ(fake_->ratesAndAttitudeSetpoints(), 0);
+}
