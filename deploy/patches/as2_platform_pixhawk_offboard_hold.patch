+/**
+ * @file offboard_guard.cpp
+ *
+ * OffboardGuard implementation. The rules are documented in offboard_guard.hpp.
+ */
+
+#include "offboard_guard.hpp"
+
+#include <cmath>
+
+namespace as2_platform_pixhawk
+{
+
+OffboardGuard::OffboardGuard(const OffboardGuardConfig & config)
+: config_(config)
+{
+}
+
+void OffboardGuard::onOdometry(
+  double t, double x, double y, double z, double yaw, uint8_t reset_counter)
+{
+  if (!(std::isfinite(x) && std::isfinite(y) && std::isfinite(z) && std::isfinite(yaw))) {
+    odometry_t_ = kNan;  // an unusable sample counts as no odometry
+    return;
+  }
+  odometry_t_ = t;
+  odom_x_ = x;
+  odom_y_ = y;
+  odom_z_ = z;
+  odom_yaw_ = yaw;
+  odom_reset_counter_ = reset_counter;
+}
+
+void OffboardGuard::onInAir(double t, bool in_air)
+{
+  in_air_t_ = t;
+  in_air_ = in_air;
+}
+
+void OffboardGuard::onControlMode(double t, bool offboard, bool armed)
+{
+  if (!have_control_mode_) {
+    if (offboard) {  // already in Offboard when this process started: not AS2's entry
+      permission_epoch_ = t;
+      hold_latched_ = false;
+    }
+  } else {
+    if (offboard && !px4_offboard_) {  // entry
+      const double since_request = t - request_t_;  // NaN without a request
+      const bool requested = since_request >= 0.0 && since_request <= config_.request_window_s;
+      if (!requested) {
+        permission_epoch_ = t;
+      }
+      hold_latched_ = false;
+    } else if (!offboard && px4_offboard_) {  // exit
+      forwarding_disabled_ = true;
+      hold_latched_ = false;
+    }
+    if (px4_armed_ && !armed) {  // disarm
+      forwarding_disabled_ = true;
+    }
+  }
+  have_control_mode_ = true;
+  control_mode_t_ = t;
+  px4_offboard_ = offboard;
+  px4_armed_ = armed;
+}
+
+void OffboardGuard::onOffboardRequested(double t)
+{
+  request_t_ = t;
+  permission_epoch_ = t;
+}
+
+void OffboardGuard::onControlModeSet(double t)
+{
+  mode_set_t_ = t;
+}
+
+void OffboardGuard::disableForwarding()
+{
+  forwarding_disabled_ = true;
+}
+
+bool OffboardGuard::heartbeatAllowed(double now, const char ** reason) const
+{
+  const char * why = nullptr;
+  // Negated comparisons so that a missing (NaN) time also fails.
+  if (!(now - odometry_t_ <= config_.odometry_timeout_s)) {
+    why = "PX4 odometry missing, stale or invalid";
+  } else if (!(now - in_air_t_ <= config_.in_air_timeout_s)) {
+    why = "EKF in-air flag missing or stale";
+  } else if (!(now - control_mode_t_ <= config_.control_mode_timeout_s)) {
+    why = "PX4 control mode missing or stale";
+  }
+  if (reason != nullptr) {
+    *reason = (why != nullptr) ? why : "";
+  }
+  return why == nullptr;
+}
+
+OffboardGuard::Decision OffboardGuard::decide(double now, bool mode_settled)
+{
+  Decision decision;
+  if (!heartbeatAllowed(now, &decision.reason)) {
+    decision.action = Action::kNone;
+    return decision;
+  }
+  if (!px4_offboard_) {
+    decision.action = Action::kHeartbeat;
+    return decision;
+  }
+
+  const bool mode_is_current = mode_set_t_ > permission_epoch_;  // false while NaN
+  if (mode_settled && mode_is_current && !forwarding_disabled_) {
+    hold_latched_ = false;  // a later hold starts where the vehicle is then
+    decision.action = Action::kForward;
+    return decision;
+  }
+
+  if (!in_air_) {
+    hold_latched_ = false;
+    decision.action = Action::kHoldGround;
+    return decision;
+  }
+
+  if (!hold_latched_ || odom_reset_counter_ != hold_reset_counter_) {
+    hold_x_ = odom_x_;
+    hold_y_ = odom_y_;
+    hold_z_ = odom_z_;
+    hold_yaw_ = odom_yaw_;
+    hold_reset_counter_ = odom_reset_counter_;
+    hold_latched_ = true;
+  }
+  decision.action = Action::kHoldAir;
+  decision.x = hold_x_;
+  decision.y = hold_y_;
+  decision.z = hold_z_;
+  decision.yaw = hold_yaw_;
+  return decision;
+}
+
+}  // namespace as2_platform_pixhawk
