+/**
+ * @file offboard_guard.hpp
+ *
+ * Offboard entry and exit policy for the PX4 platform, free of ROS so every
+ * rule is unit tested (tests/offboard_guard_gtest.cpp). Checked against PX4
+ * v1.15.0 source.
+ *
+ *  A. Outside Offboard only the offboard_control_mode heartbeat is sent, never
+ *     a setpoint. PX4's uXRCE-DDS client publishes /fmu/in setpoints straight
+ *     into the controllers' uORB topics in every flight mode
+ *     (uxrce_dds_client/dds_topics.h.em), so a setpoint sent outside Offboard
+ *     is mixed into POSITION, Land or any other mode. The heartbeat is sent
+ *     only while PX4 odometry, the EKF in-air flag and the PX4 control mode are
+ *     fresh; otherwise PX4 cannot enter Offboard.
+ *  B. Every Offboard entry starts with a hold. In the air: the position and
+ *     yaw captured at entry, re-captured after an estimator reset. On the
+ *     ground: zero velocity and no position, which cannot trigger PX4's
+ *     offboard takeoff (mc_pos_control/MulticopterPositionControl.cpp).
+ *  C. AS2 commands are forwarded only when a control mode was set after the
+ *     AS2 offboard request, or after an entry AS2 did not request.
+ *  D. After any Offboard exit or disarm, AS2 commands are never forwarded again
+ *     by this process: restart the platform node.
+ *
+ * Times are seconds on a monotonic clock, taken when each message arrives.
+ */
+
+#ifndef AS2_PLATFORM_PIXHAWK__OFFBOARD_GUARD_HPP_
+#define AS2_PLATFORM_PIXHAWK__OFFBOARD_GUARD_HPP_
+
+#include <cstdint>
+#include <limits>
+
+namespace as2_platform_pixhawk
+{
+
+struct OffboardGuardConfig
+{
+  double odometry_timeout_s = 0.2;      // vehicle_odometry arrives at ~100 Hz
+  double in_air_timeout_s = 3.0;        // estimator_status_flags: ~1 Hz and on change
+  double control_mode_timeout_s = 1.5;  // vehicle_control_mode: >= 2 Hz and on change
+  double request_window_s = 2.0;        // entry this soon after an AS2 request is AS2's
+};
+
+class OffboardGuard
+{
+public:
+  static constexpr double kNan = std::numeric_limits<double>::quiet_NaN();
+
+  enum class Action
+  {
+    kNone,        // publish nothing
+    kHeartbeat,   // offboard_control_mode only
+    kHoldAir,     // position and yaw hold at x, y, z, yaw (PX4 local NED)
+    kHoldGround,  // zero velocity, no position
+    kForward      // AS2 commands
+  };
+
+  struct Decision
+  {
+    Action action = Action::kNone;
+    double x = kNan;
+    double y = kNan;
+    double z = kNan;
+    double yaw = kNan;
+    const char * reason = "";
+  };
+
+  explicit OffboardGuard(const OffboardGuardConfig & config = OffboardGuardConfig());
+
+  void onOdometry(double t, double x, double y, double z, double yaw, uint8_t reset_counter);
+  void onInAir(double t, bool in_air);
+  void onControlMode(double t, bool offboard, bool armed);
+  void onOffboardRequested(double t);
+  void onControlModeSet(double t);
+  void disableForwarding();
+
+  bool heartbeatAllowed(double now, const char ** reason = nullptr) const;
+  Decision decide(double now, bool mode_settled);
+  bool forwardingDisabled() const {return forwarding_disabled_;}
+
+private:
+  OffboardGuardConfig config_;
+
+  double odometry_t_ = kNan;
+  double odom_x_ = kNan;
+  double odom_y_ = kNan;
+  double odom_z_ = kNan;
+  double odom_yaw_ = kNan;
+  uint8_t odom_reset_counter_ = 0;
+
+  double in_air_t_ = kNan;
+  bool in_air_ = false;
+
+  double control_mode_t_ = kNan;
+  bool have_control_mode_ = false;
+  bool px4_offboard_ = false;
+  bool px4_armed_ = false;
+
+  double request_t_ = kNan;
+  double mode_set_t_ = kNan;
+  double permission_epoch_ = -std::numeric_limits<double>::infinity();
+  bool forwarding_disabled_ = false;
+
+  bool hold_latched_ = false;
+  double hold_x_ = kNan;
+  double hold_y_ = kNan;
+  double hold_z_ = kNan;
+  double hold_yaw_ = kNan;
+  uint8_t hold_reset_counter_ = 0;
+};
+
+}  // namespace as2_platform_pixhawk
+
+#endif  // AS2_PLATFORM_PIXHAWK__OFFBOARD_GUARD_HPP_
