+
+/**
+ * @file offboard_guard_gtest.cpp
+ *
+ * Unit tests for OffboardGuard, one or more per rule in offboard_guard.hpp.
+ * Default timeouts: odometry 0.2 s, in-air flag 3.0 s, control mode 1.5 s,
+ * request window 2.0 s.
+ */
+
+#include <gtest/gtest.h>
+
+#include <cmath>
+#include <cstring>
+
+#include "offboard_guard.hpp"
+
+namespace as2_platform_pixhawk
+{
+namespace
+{
+
+using Action = OffboardGuard::Action;
+
+// Feeds all three inputs at time t, so the freshness gate passes at t.
+void feed(
+  OffboardGuard & g, double t, bool offboard, bool armed, bool in_air,
+  double x = 1.0, double y = 2.0, double z = -3.0, double yaw = 0.5, uint8_t reset = 0)
+{
+  g.onOdometry(t, x, y, z, yaw, reset);
+  g.onInAir(t, in_air);
+  g.onControlMode(t, offboard, armed);
+}
+
+// Rule A: freshness gate.
+
+TEST(OffboardGuard, NoInputsPublishesNothing)
+{
+  OffboardGuard g;
+  EXPECT_FALSE(g.heartbeatAllowed(10.0));
+  EXPECT_EQ(g.decide(10.0, true).action, Action::kNone);
+}
+
+TEST(OffboardGuard, EachStaleInputStopsHeartbeatWithItsReason)
+{
+  OffboardGuard g;
+  const char * reason = "";
+  feed(g, 0.0, false, true, true);
+  EXPECT_EQ(g.decide(0.1, false).action, Action::kHeartbeat);
+
+  EXPECT_FALSE(g.heartbeatAllowed(0.25, &reason));  // odometry 0.25 s old
+  EXPECT_NE(std::strstr(reason, "odometry"), nullptr);
+  EXPECT_EQ(g.decide(0.25, false).action, Action::kNone);
+
+  g.onOdometry(1.6, 1.0, 2.0, -3.0, 0.5, 0);  // control mode now 1.6 s old
+  EXPECT_FALSE(g.heartbeatAllowed(1.6, &reason));
+  EXPECT_NE(std::strstr(reason, "control mode"), nullptr);
+  g.onControlMode(1.6, false, true);
+  EXPECT_EQ(g.decide(1.6, false).action, Action::kHeartbeat);
+
+  g.onOdometry(3.1, 1.0, 2.0, -3.0, 0.5, 0);  // in-air flag now 3.1 s old
+  g.onControlMode(3.1, false, true);
+  EXPECT_FALSE(g.heartbeatAllowed(3.1, &reason));
+  EXPECT_NE(std::strstr(reason, "in-air"), nullptr);
+  g.onInAir(3.1, true);
+  EXPECT_TRUE(g.heartbeatAllowed(3.1, &reason));
+  EXPECT_STREQ(reason, "");
+}
+
+TEST(OffboardGuard, InvalidOdometrySampleStopsHeartbeat)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onOdometry(0.05, NAN, 2.0, -3.0, 0.5, 0);
+  EXPECT_EQ(g.decide(0.05, false).action, Action::kNone);
+  g.onOdometry(0.06, 1.0, 2.0, -3.0, NAN, 0);
+  EXPECT_EQ(g.decide(0.06, false).action, Action::kNone);
+}
+
+TEST(OffboardGuard, OutsideOffboardOnlyHeartbeat)
+{
+  for (bool armed : {false, true}) {
+    for (bool in_air : {false, true}) {
+      for (bool settled : {false, true}) {
+        OffboardGuard g;
+        feed(g, 0.0, false, armed, in_air);
+        g.onOffboardRequested(0.01);
+        g.onControlModeSet(0.02);
+        EXPECT_EQ(g.decide(0.03, settled).action, Action::kHeartbeat)
+          << "armed=" << armed << " in_air=" << in_air << " settled=" << settled;
+      }
+    }
+  }
+}
+
+// Rule B: every entry starts with a hold.
+
+TEST(OffboardGuard, RcEntryInAirHoldsEntryPoseNotLaterPose)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true, 1.0, 2.0, -3.0, 0.5);
+  feed(g, 0.1, true, true, true, 1.0, 2.0, -3.0, 0.5);  // RC offboard switch
+  auto d = g.decide(0.1, false);
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.x, 1.0);
+  EXPECT_DOUBLE_EQ(d.y, 2.0);
+  EXPECT_DOUBLE_EQ(d.z, -3.0);
+  EXPECT_DOUBLE_EQ(d.yaw, 0.5);
+
+  feed(g, 0.15, true, true, true, 1.4, 2.3, -2.8, 0.7);  // drift; hold point stays
+  d = g.decide(0.15, false);
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.x, 1.0);
+  EXPECT_DOUBLE_EQ(d.y, 2.0);
+  EXPECT_DOUBLE_EQ(d.z, -3.0);
+  EXPECT_DOUBLE_EQ(d.yaw, 0.5);
+}
+
+TEST(OffboardGuard, GroundEntryHoldsGroundThenLatchesAtLiftoffAndReturnsToGround)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, false, 0.0, 0.0, 0.0, 0.1);
+  feed(g, 0.05, true, true, false, 0.0, 0.0, 0.0, 0.1);
+  auto d = g.decide(0.05, false);
+  EXPECT_EQ(d.action, Action::kHoldGround);
+  EXPECT_TRUE(std::isnan(d.x));
+
+  feed(g, 0.1, true, true, true, 0.1, 0.2, -0.5, 0.2);
+  d = g.decide(0.1, false);
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.z, -0.5);
+
+  feed(g, 0.2, true, true, false, 0.1, 0.2, 0.0, 0.2);  // touched down
+  EXPECT_EQ(g.decide(0.2, false).action, Action::kHoldGround);
+}
+
+TEST(OffboardGuard, EstimatorResetRelatchesHold)
+{
+  OffboardGuard g;
+  feed(g, 0.0, true, true, true, 1.0, 1.0, -1.0, 0.0, 7);
+  EXPECT_DOUBLE_EQ(g.decide(0.0, false).x, 1.0);
+  feed(g, 0.1, true, true, true, 3.0, 1.0, -1.0, 0.0, 7);
+  EXPECT_DOUBLE_EQ(g.decide(0.1, false).x, 1.0);  // same counter: still latched
+  feed(g, 0.2, true, true, true, 3.0, 1.0, -1.0, 0.0, 8);
+  EXPECT_DOUBLE_EQ(g.decide(0.2, false).x, 3.0);  // reset: re-latched where the vehicle is
+}
+
+TEST(OffboardGuard, StaleInputsDuringHoldPublishNothingAndKeepHoldPoint)
+{
+  OffboardGuard g;
+  feed(g, 0.0, true, true, true, 1.0, 1.0, -1.0, 0.0);
+  EXPECT_EQ(g.decide(0.0, false).action, Action::kHoldAir);
+  EXPECT_EQ(g.decide(0.3, false).action, Action::kNone);  // odometry 0.3 s old
+  feed(g, 0.35, true, true, true, 1.2, 1.0, -1.0, 0.0);
+  const auto d = g.decide(0.35, false);
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.x, 1.0);  // same hold point
+}
+
+TEST(OffboardGuard, StartupAlreadyInOffboardCountsAsUnrequestedEntry)
+{
+  OffboardGuard g;
+  g.onControlModeSet(0.0);
+  feed(g, 0.05, true, true, true);
+  EXPECT_EQ(g.decide(0.05, true).action, Action::kHoldAir);
+  g.onControlModeSet(0.1);
+  EXPECT_EQ(g.decide(0.1, true).action, Action::kForward);
+}
+
+// Rule C: which control modes may be forwarded.
+
+TEST(OffboardGuard, RcEntryIgnoresModeSetBeforeEntry)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onControlModeSet(0.05);  // a behaviour set a mode outside Offboard
+  feed(g, 0.1, true, true, true);
+  EXPECT_EQ(g.decide(0.1, true).action, Action::kHoldAir);
+}
+
+TEST(OffboardGuard, RcEntryForwardsModeSetAfterEntry)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  feed(g, 0.1, true, true, true);
+  EXPECT_EQ(g.decide(0.1, false).action, Action::kHoldAir);
+  g.onControlModeSet(0.12);
+  EXPECT_EQ(g.decide(0.13, true).action, Action::kForward);
+}
+
+TEST(OffboardGuard, ForwardRequiresSettledMode)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onOffboardRequested(0.05);
+  feed(g, 0.1, true, true, true);
+  g.onControlModeSet(0.12);
+  EXPECT_EQ(g.decide(0.13, false).action, Action::kHoldAir);
+}
+
+TEST(OffboardGuard, RequestedEntryForwardsModeSetBeforePx4ReportsOffboard)
+{
+  // DroneInterface order offboard(), arm(), takeoff(): the takeoff mode can be
+  // set before PX4's control mode report arrives.
+  OffboardGuard g;
+  feed(g, 0.0, false, false, false);
+  g.onOffboardRequested(0.1);
+  g.onControlModeSet(0.3);
+  feed(g, 0.4, true, true, false);
+  EXPECT_EQ(g.decide(0.4, true).action, Action::kForward);
+}
+
+TEST(OffboardGuard, RequestedEntryHoldsModeSetBeforeRequest)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onControlModeSet(0.05);
+  g.onOffboardRequested(0.1);
+  feed(g, 0.2, true, true, true);
+  EXPECT_EQ(g.decide(0.2, true).action, Action::kHoldAir);
+}
+
+TEST(OffboardGuard, EntryOutsideRequestWindowCountsAsUnrequested)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onOffboardRequested(0.1);  // e.g. refused by PX4
+  g.onControlModeSet(0.2);
+  feed(g, 2.5, true, true, true);  // RC entry 2.4 s after the request
+  EXPECT_EQ(g.decide(2.5, true).action, Action::kHoldAir);
+}
+
+TEST(OffboardGuard, HoldAfterForwardingStartsAtCurrentPose)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true, 0.0, 0.0, -1.0, 0.0);
+  g.onOffboardRequested(0.05);
+  feed(g, 0.1, true, true, true, 0.0, 0.0, -1.0, 0.0);
+  EXPECT_EQ(g.decide(0.1, false).action, Action::kHoldAir);
+  g.onControlModeSet(0.15);
+  EXPECT_EQ(g.decide(0.15, true).action, Action::kForward);
+  feed(g, 0.2, true, true, true, 2.0, 1.0, -1.5, 0.3);  // AS2 flew elsewhere
+  const auto d = g.decide(0.2, false);  // mode no longer settled
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.x, 2.0);
+  EXPECT_DOUBLE_EQ(d.y, 1.0);
+  EXPECT_DOUBLE_EQ(d.z, -1.5);
+  EXPECT_DOUBLE_EQ(d.yaw, 0.3);
+}
+
+// Rule D: exit or disarm ends forwarding for this process.
+
+TEST(OffboardGuard, ExitEndsForwardingForThisProcess)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onOffboardRequested(0.1);
+  feed(g, 0.2, true, true, true);
+  g.onControlModeSet(0.25);
+  EXPECT_EQ(g.decide(0.25, true).action, Action::kForward);
+
+  feed(g, 0.3, false, true, true);  // pilot takeover, watchdog land or failsafe
+  EXPECT_TRUE(g.forwardingDisabled());
+  EXPECT_EQ(g.decide(0.3, true).action, Action::kHeartbeat);
+
+  g.onOffboardRequested(0.35);
+  feed(g, 0.4, true, true, true, 5.0, 6.0, -2.0, 1.0);
+  g.onControlModeSet(0.45);
+  const auto d = g.decide(0.5, true);
+  ASSERT_EQ(d.action, Action::kHoldAir);
+  EXPECT_DOUBLE_EQ(d.x, 5.0);  // holds at the re-entry pose
+}
+
+TEST(OffboardGuard, DisarmEndsForwardingForThisProcess)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, false, false);
+  g.onOffboardRequested(0.1);
+  feed(g, 0.2, true, true, false);
+  g.onControlModeSet(0.25);
+  EXPECT_EQ(g.decide(0.25, true).action, Action::kForward);
+
+  feed(g, 0.3, true, false, false);  // auto-disarm after landing, still Offboard
+  EXPECT_TRUE(g.forwardingDisabled());
+  EXPECT_EQ(g.decide(0.3, true).action, Action::kHoldGround);
+
+  g.onOffboardRequested(0.35);
+  g.onControlModeSet(0.4);
+  feed(g, 0.45, true, true, false);
+  EXPECT_EQ(g.decide(0.45, true).action, Action::kHoldGround);
+}
+
+TEST(OffboardGuard, DisableForwardingHolds)
+{
+  OffboardGuard g;
+  feed(g, 0.0, false, true, true);
+  g.onOffboardRequested(0.05);
+  feed(g, 0.1, true, true, true);
+  g.onControlModeSet(0.12);
+  EXPECT_EQ(g.decide(0.13, true).action, Action::kForward);
+  g.disableForwarding();
+  EXPECT_EQ(g.decide(0.14, true).action, Action::kHoldAir);
+}
+
+}  // namespace
+}  // namespace as2_platform_pixhawk
