+/**
+ * @brief Publish the offboard heartbeat alone. The position flag makes PX4
+ * accept Offboard only with a valid local position.
+ */
+void PixhawkPlatform::PX4publishOffboardHeartbeat()
+{
+  px4_msgs::msg::OffboardControlMode heartbeat{};
+  heartbeat.position = true;
+  heartbeat.timestamp = this->get_clock()->now().nanoseconds() / 1000;
+  px4_offboard_control_mode_pub_->publish(heartbeat);
+}
+
+/**
+ * @brief Publish a hold setpoint and the heartbeat. In the air: position and
+ * yaw hold. On the ground: zero velocity and no position, which PX4 does not
+ * treat as a takeoff request.
+ */
+void PixhawkPlatform::PX4publishHoldSetpoint(const OffboardGuard::Decision & decision)
+{
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  px4_msgs::msg::TrajectorySetpoint setpoint{};
+  setpoint.position = {nan, nan, nan};
+  setpoint.velocity = {nan, nan, nan};
+  setpoint.acceleration = {nan, nan, nan};
+  setpoint.jerk = {nan, nan, nan};
+  setpoint.yaw = nan;
+  setpoint.yawspeed = nan;
+
+  if (decision.action == OffboardGuard::Action::kHoldAir) {
+    setpoint.position = {
+      static_cast<float>(decision.x), static_cast<float>(decision.y),
+      static_cast<float>(decision.z)};
+    setpoint.yaw = static_cast<float>(decision.yaw);
+  } else {
+    setpoint.velocity = {0.0f, 0.0f, 0.0f};
+  }
+
+  setpoint.timestamp = this->get_clock()->now().nanoseconds() / 1000;
+  px4_trajectory_setpoint_pub_->publish(setpoint);
+  PX4publishOffboardHeartbeat();
+}
+
+void PixhawkPlatform::logOffboardAction(const OffboardGuard::Decision & decision)
+{
+  switch (decision.action) {
+    case OffboardGuard::Action::kNone:
+      RCLCPP_WARN(this->get_logger(), "No offboard heartbeat: %s", decision.reason);
+      break;
+    case OffboardGuard::Action::kHeartbeat:
+      RCLCPP_INFO(this->get_logger(), "Offboard heartbeat only: PX4 is not in Offboard");
+      break;
+    case OffboardGuard::Action::kHoldAir:
+      RCLCPP_WARN(
+        this->get_logger(), "OFFBOARD HOLD in the air at NED %.2f %.2f %.2f, yaw %.2f rad",
+        decision.x, decision.y, decision.z, decision.yaw);
+      break;
+    case OffboardGuard::Action::kHoldGround:
+      RCLCPP_WARN(this->get_logger(), "OFFBOARD HOLD on the ground: zero velocity, no takeoff");
+      break;
+    case OffboardGuard::Action::kForward:
+      RCLCPP_INFO(this->get_logger(), "Forwarding AS2 commands to PX4");
+      break;
+  }
+}
