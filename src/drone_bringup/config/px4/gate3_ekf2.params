# filepath: src/drone_bringup/config/px4/gate3_ekf2.params
# Apply via QGroundControl. Reboot FC after applying. Values are decimal.
# Firmware: PX4 v1.15.x (confirmed by operator 2026-07-04).

# ---- uXRCE-DDS link on TELEM2 ----
MAV_1_CONFIG      0        # free TELEM2 from MAVLink if previously assigned
UXRCE_DDS_CFG     102      # TELEM2 [VERIFY]: select "TELEM2" in QGC dropdown, enum value may differ
SER_TEL2_BAUD     921600
UXRCE_DDS_SYNCT   1        # timesync ON; odom_bridge_node timestamps depend on this [FIXED]

# ---- EKF2: external vision as primary, indoor profile ----
EKF2_EV_CTRL      11       # bit0 hpos + bit1 vpos + bit3 yaw = 11. Velocity NOT fused. [FIXED]
EKF2_HGT_REF      3        # vision height reference
EKF2_EV_DELAY     50.0     # ms, initial guess; tune from log cross-correlation after Gate 3
EKF2_EV_NOISE_MD  1        # use fixed noise params below, ignore message covariance
EKF2_EVP_NOISE    0.05     # m
EKF2_EVA_NOISE    0.05     # rad
EKF2_GPS_CTRL     0        # no GPS fusion
SYS_HAS_GPS       0        # suppress GPS preflight requirement [VERIFY name]
EKF2_MAG_TYPE     5        # magnetometer: None (indoor steel environment; yaw comes from EV)
EKF2_BARO_CTRL    1        # baro stays as a consistency aid, NOT height reference

# ---- Optical flow (HereFlow, DroneCAN) as divergence backstop ----
UAVCAN_ENABLE     2        # sensors automatic [VERIFY: 2 vs 3 per firmware docs]
EKF2_OF_CTRL      1
SENS_FLOW_ROT     0        # [MEASURE]: HereFlow mounting yaw on the X500
EKF2_RNG_CTRL     1        # rangefinder conditional aiding: terrain/landing, NOT height ref

# ---- Gate 4 tethered-test safety envelope ----
MPC_XY_VEL_MAX    1.0      # m/s
MPC_Z_VEL_MAX_UP  0.5
MPC_Z_VEL_MAX_DN  0.5
MPC_TILTMAX_AIR   20.0     # deg
COM_DISARM_LAND   2.0      # s
NAV_RCL_ACT       3        # RC loss -> LAND (never Return indoors)
GF_ACTION         0        # PX4 native geofence OFF (global-position based, useless here)
COM_OBL_RC_ACT    0        # [VERIFY] irrelevant until offboard; leave default if absent

# ---- Manual steps recorded, not params ----
# 1. Assign a kill switch on the RC transmitter (RC_MAP_KILL_SW) and test it disarmed.
# 2. Verify motor order/direction and prop installation before ANY powered test.
# 3. Mid-360 mounted on vibration-isolating foam standoffs before Gate 4.
